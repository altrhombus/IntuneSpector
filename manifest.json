{
  "manifest_version": 3,
  "name": "IntuneSpector",
  "version": "0.1.0",
  "description": "Rich contextual enrichment for the Microsoft Intune admin portal",
  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://intune.microsoft.com/*",
    "https://graph.microsoft.com/*",
    "https://services.autopatch.microsoft.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://intune.microsoft.com/*"
      ],
      "js": [
        "src/content/index.tsx"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://intune.microsoft.com/*"]
    }
  ]
}
